{
  "rules": {
    ".read": false,
    ".write": false,
    "accounts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "studies": {
      "$studyId": {
        "settings": {
          ".read": "auth != null && root.child('accounts').child(auth.uid).child('studyId').val() === $studyId && root.child('accounts').child(auth.uid).child('active').val() === true"
        }
      }
    }
  }
}
